                <&macro_tap_time 27>,
                <&kp DOWN>,
                <&macro_wait_time 5109>;
        };

        /* 30 min session - 9 randomized cycles, ~31 min total */

        Scrl_30: Scrl_30 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&Scrl_Drift &Scrl_Read &Scrl_Lazy &Scrl_Rush &Scrl_Read &Scrl_Lazy &Scrl_Drift &Scrl_Rush &Scrl_Rush &Scrl_Drift &Scrl_Read &Scrl_Lazy &Scrl_Lazy &Scrl_Read &Scrl_Rush &Scrl_Drift &Scrl_Drift &Scrl_Rush &Scrl_Lazy &Scrl_Read &Scrl_Read &Scrl_Drift &Scrl_Rush &Scrl_Lazy &Scrl_Rush &Scrl_Lazy &Scrl_Drift &Scrl_Read &Scrl_Lazy &Scrl_Drift &Scrl_Read &Scrl_Rush &Scrl_Read &Scrl_Rush &Scrl_Drift &Scrl_Lazy>;
        };
